<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="СМО" Height="640" Width="880"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: ВВОД -->
        <StackPanel Grid.Column="0">

            <GroupBox Header="Тип СМО" Padding="6">
                <ComboBox x:Name="CmbType" SelectedIndex="0"
                          SelectionChanged="CmbType_SelectionChanged">
                    <ComboBoxItem Content="1. Одноканальная с отказами" Tag="1"/>
                    <ComboBoxItem Content="2. Одноканальная с неогр. очередью" Tag="2"/>
                    <ComboBoxItem Content="3. Одноканальная с огр. очередью" Tag="3"/>
                    <ComboBoxItem Content="4. Многоканальная с отказами" Tag="4"/>
                    <ComboBoxItem Content="5. Многоканальная с неогр. очередью" Tag="5"/>
                    <ComboBoxItem Content="6. Многоканальная с огр. очередью" Tag="6"/>
                </ComboBox>
            </GroupBox>

            <GroupBox Header="Исходные данные" Padding="6" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="λ:"/>
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLambda" Text="10"/>
                        <ComboBox x:Name="CmbLambdaUnit" Grid.Column="1"
                                  SelectedIndex="1" Margin="4,0,0,0">
                            <ComboBoxItem Content="за минуту" Tag="min"/>
                            <ComboBoxItem Content="за час" Tag="hour"/>
                            <ComboBoxItem Content="за сутки" Tag="day"/>
                        </ComboBox>
                    </Grid>

                    <RadioButton x:Name="RbMu" Content="задать μ"
                                 IsChecked="True" Checked="RbMode_Checked"/>
                    <RadioButton x:Name="RbTime" Content="задать t_об"
                                 Checked="RbMode_Checked"/>

                    <StackPanel x:Name="PnlMu">
                        <TextBlock Text="μ:" Margin="0,6,0,0"/>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMu" Text="12"/>
                            <ComboBox x:Name="CmbMuUnit" Grid.Column="1"
                                      SelectedIndex="1" Margin="4,0,0,0">
                                <ComboBoxItem Content="за минуту" Tag="min"/>
                                <ComboBoxItem Content="за час" Tag="hour"/>
                                <ComboBoxItem Content="за сутки" Tag="day"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PnlTime" Visibility="Collapsed">
                        <TextBlock Text="t_об:" Margin="0,6,0,0"/>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTime" Text="5"/>
                            <ComboBox x:Name="CmbTimeUnit" Grid.Column="1"
                                      SelectedIndex="0" Margin="4,0,0,0">
                                <ComboBoxItem Content="минут" Tag="min"/>
                                <ComboBoxItem Content="часов" Tag="hour"/>
                                <ComboBoxItem Content="суток" Tag="day"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PnlN" Visibility="Collapsed">
                        <TextBlock Text="n (каналов):" Margin="0,6,0,0"/>
                        <TextBox x:Name="TxtN" Text="2" Margin="0,2,0,6"/>
                    </StackPanel>

                    <StackPanel x:Name="PnlM" Visibility="Collapsed">
                        <TextBlock Text="m (макс. очередь):" Margin="0,6,0,0"/>
                        <TextBox x:Name="TxtM" Text="3" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Рассчитать" Click="BtnCalc_Click"
                        Padding="10,5" Width="110"/>
                <Button Content="Очистить" Click="BtnClear_Click"
                        Padding="10,5" Width="90" Margin="6,0,0,0"/>
            </StackPanel>

            <Button Content="Экспорт в Excel" Click="BtnExport_Click"
                    Padding="10,5" Margin="0,6,0,0" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ: РЕЗУЛЬТАТЫ -->
        <GroupBox Grid.Column="1" Header="Результаты" Padding="6" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtHeader"
                           Text="расчёт не выполнен"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>

                <TextBox x:Name="TxtOut" Grid.Row="1"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="#FAFAFA"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Text="Выберите тип СМО, введите данные и нажмите «Рассчитать»."/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>